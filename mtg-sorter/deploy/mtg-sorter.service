# Starts the web app when the Pi boots, and restarts it if it crashes.
# Install: sudo cp deploy/mtg-sorter.service /etc/systemd/system/
#          sudo systemctl enable --now mtg-sorter
[Unit]
Description=MTG sorter web app
After=network-online.target
Wants=network-online.target

[Service]
User=nic
WorkingDirectory=/home/nic/HomeLab/mtg-sorter
# Listens on the home network too (http://mtgsorter.local:5000) as well as through Tailscale Serve.
# The app has no login: use --host 127.0.0.1 instead to keep it off the home network.
# Uses the Pi camera; to test without one, add: --demo /home/nic/photos
ExecStart=/home/nic/HomeLab/mtg-sorter/.venv/bin/python app.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
